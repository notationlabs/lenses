{
  "manifest_version": 3,
  "name": "Lens Host",
  "version": "0.3.5",
  "description": "Executes lens calls from local clients in your own browser session.",
  "key": "",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": ["tabs", "alarms", "storage", "notifications", "debugger"],
  "icons": { "128": "icon128.png" },
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
