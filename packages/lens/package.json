{
  "name": "@djgrant/lens",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./page-stamp": {
      "types": "./dist/page-stamp.d.ts",
      "bun": "./src/page-stamp.ts",
      "import": "./dist/page-stamp.js"
    },
    "./graphql": {
      "types": "./dist/graphql.d.ts",
