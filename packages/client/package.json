{
  "name": "@djgrant/lenses-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./electron-host": {
      "types": "./dist/electron-host.d.ts",
      "bun": "./src/electron-host.ts",
      "import": "./dist/electron-host.js"
    },
    "./broker-daemon": {
      "types": "./dist/broker-daemon.d.ts",
      "bun": "./src/broker-daemon.ts",
      "import": "./dist/broker-daemon.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@djgrant/lenses-core": "workspace:*",
    "puppeteer-core": "^25.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
