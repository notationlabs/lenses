{
  "name": "@djgrant/hn/item",
  "description": "A Hacker News story page: the story plus a page of its comment thread. HN serves the whole thread in one document, so the lens windows it client-side (default 30 comments/page); next_page is the same lens at the next window (null on the last page). Pass params {page, limit} to control the window.",
  "url": "https://news.ycombinator.com/item?id={id}",
  "params": {
    "id": "string",
    "page": {
      "type": "integer",
      "default": 1
    },
    "limit": {
      "type": "integer",
      "default": 30
    }
  },
  "returns": {
    "type": "object",
    "fields": {
      "story": {
        "type": "object",
        "fields": {
          "title": "string",
          "url": "string",
          "score": "string"
        }
      },
      "comments": {
        "type": "array",
        "items": {
          "author": "string",
          "age": "string",
          "text": "string"
        }
      },
      "next_page": {
        "$lens": "@djgrant/hn/item",
        "params": {
          "id": "$id",
          "page": "$page + 1",
          "limit": "$limit"
        }
      }
    }
  },
  "outcomes": {
    "not_found": null
  },
  "effects": {
    "reads": [
      "news.ycombinator.com"
    ],
    "writes": [],
    "idempotent": true,
    "cache": 120
  },
  "resolve": [
    {
      "kind": "dom",
      "item": ".comtr",
      "fields": {
        "author": {
          "selector": ".hnuser"
        },
        "age": {
          "selector": ".age"
        },
        "text": {
          "selector": ".commtext"
        },
        "indent": {
          "selector": ".ind",
          "attr": "indent"
        }
      },
      "post": "($all := $[text != null]; $size := $number($limit ? $limit : 30); $pg := $number($page ? $page : 1); $start := ($pg - 1) * $size; { \"story\": { \"id\": $id }, \"comments\": [$all#$i[$i >= $start and $i < $start + $size]], \"next_page\": ($count($all) > $start + $size) ? \"https://news.ycombinator.com/item?id=\" & $id & \"&p=\" & ($pg + 1) : null })"
    },
    {
      "kind": "dom",
      "fields": {
        "title": {
          "selector": ".titleline > a"
        },
        "url": {
          "selector": ".titleline > a",
          "attr": "href"
        },
        "score": {
          "selector": ".score"
        }
      },
      "post": "{ 'story': $ }"
    },
    {
      "kind": "llm",
      "prompt": "This is a Hacker News story page. Return {story: {title, url, score}, comments: [{author, age, text}], next_page}. Return at most 30 comments in reading order. If you can see more than 30 comments on the page, set next_page to the URL of this page with the query param &p=2 appended (page 2 of the client-side window); otherwise set next_page to null. Include only fields you can actually see."
    }
  ]
}
