{
  "name": "@djgrant/claude/usage",
  "description": "The logged-in user's Claude.ai usage settings page: current plan, session and weekly usage limits, and whether usage credits are enabled.",
  "url": "https://claude.ai/settings/usage",
  "loadTimeoutMs": 45000,
  "returns": {
    "type": "object",
    "fields": {
      "plan": "string",
      "limits": {
        "type": "array",
        "items": {
          "name": "string",
          "percent": "string",
          "resets_at": { "type": "string", "nullable": true }
        }
      },
      "usage_credits": {
        "type": "object",
        "fields": {
          "enabled": "boolean",
          "spent_minor": "integer",
          "monthly_limit_minor": "integer",
          "balance_minor": "integer",
          "currency": "string",
          "percent": "string",
          "resets_at": "string",
          "auto_reload": "boolean"
        }
      }
    }
  },
  "outcomes": {
    "needs_auth": { "$lens": "@djgrant/claude/login", "hint": "Ask the user to sign in to claude.ai in the open tab, then retry this call." }
  },
  "effects": {
    "reads": ["claude.ai/settings/usage"],
    "writes": [],
    "idempotent": true,
    "cache": 60
  },
  "resolve": [
    {
      "kind": "http",
      "credentials": true,
      "sources": {
        "orgs": {
          "request": "GET https://claude.ai/api/organizations"
        },
        "usage": {
          "request": "GET https://claude.ai/api/organizations/{orgs.0.uuid}/usage"
        },
        "credits": {
          "request": "GET https://claude.ai/api/organizations/{orgs.0.uuid}/overage_spend_limit"
        },
        "balance": {
          "request": "GET https://claude.ai/api/organizations/{orgs.0.uuid}/prepaid/credits"
        },
        "bundles": {
          "request": "GET https://claude.ai/api/organizations/{orgs.0.uuid}/prepaid/bundles"
        }
      },
      "detect": {
        "needs_auth": "$orgs.status = 401 or $orgs.status = 403 or $usage.status = 401 or $usage.status = 403"
      },
      "map": {
        "plan": "$orgs[0].rate_limit_tier",
        "limits": "[$usage.limits.{ 'name': kind = 'session' ? 'Current session' : kind = 'weekly_all' ? 'Weekly limit' : kind = 'weekly_scoped' ? ((scope.model.display_name ? scope.model.display_name & ' ' : '') & 'weekly limit') : kind, 'percent': $string(percent) & '%', 'resets_at': resets_at }]",
        "usage_credits": "{ 'enabled': $credits.is_enabled = true, 'spent_minor': $credits.used_credits, 'monthly_limit_minor': $credits.monthly_credit_limit, 'balance_minor': $balance.amount, 'currency': $credits.currency, 'percent': $credits.monthly_credit_limit > 0 ? $string($round($credits.used_credits * 100 / $credits.monthly_credit_limit)) & '%' : '', 'resets_at': $bundles.purchases_reset_at, 'auto_reload': $balance.auto_reload_settings ? true : false }"
      }
    },
    {
      "kind": "intercept",
      "sources": {
        "usage": {
          "request": "GET https://claude.ai/api/organizations/*/usage*"
        },
        "credits": {
          "request": "GET https://claude.ai/api/organizations/*/overage_spend_limit*"
        },
        "balance": {
          "request": "GET https://claude.ai/api/organizations/*/prepaid/credits*"
        },
        "bundles": {
          "request": "GET https://claude.ai/api/organizations/*/prepaid/bundles*"
        }
      },
      "reloadOnMiss": true,
      "waitMs": 8000,
      "detect": {
        "needs_auth": "$usage.status = 401 or $usage.status = 403 or $credits.status = 401 or $credits.status = 403"
      },
      "map": {
        "limits": "[$usage.limits.{ 'name': kind = 'session' ? 'Current session' : kind = 'weekly_all' ? 'Weekly limit' : kind = 'weekly_scoped' ? ((scope.model.display_name ? scope.model.display_name & ' ' : '') & 'weekly limit') : kind, 'percent': $string(percent) & '%', 'resets_at': resets_at }]",
        "usage_credits": "{ 'enabled': $credits.is_enabled = true, 'spent_minor': $credits.used_credits, 'monthly_limit_minor': $credits.monthly_credit_limit, 'balance_minor': $balance.amount, 'currency': $credits.currency, 'percent': $credits.monthly_credit_limit > 0 ? $string($round($credits.used_credits * 100 / $credits.monthly_credit_limit)) & '%' : '', 'resets_at': $bundles.purchases_reset_at, 'auto_reload': $balance.auto_reload_settings ? true : false }"
      }
    },
    {
      "kind": "dom",
      "detect": {
        "needs_auth": "$contains(url, '/login') or $contains(url, '/logout') or $contains(title, 'Log in')"
      },
      "fields": {
        "dialog": { "selector": "[role='dialog']" }
      },
      "post": "(dialog and $contains(dialog, 'Plan usage limits')) ? ($a := $substringAfter(dialog, 'Plan usage limits'); $contains($a, 'Current session') ? { 'plan': $trim($substringBefore($a, 'Current session')) } : {}) : {}"
    },
    {
      "kind": "llm",
      "prompt": "This is the Claude.ai usage settings page. Return a single object {plan, limits, usage_credits}. plan is the current subscription plan name shown under the 'Plan usage limits' heading. limits is an array of {name, percent, resets_at}. usage_credits is {enabled, spent_minor, monthly_limit_minor, balance_minor, currency, percent, resets_at, auto_reload}; monetary values are integer minor currency units, so 4000 GBP means £40.00. If the page is a login/sign-in page, return the JSON string \"needs_auth\"."
    }
  ]
}
