{
  "name": "@djgrant/claude/usage",
  "description": "The logged-in user's Claude.ai usage settings page: current plan, session and weekly usage limits, and whether usage credits are enabled.",
  "url": "https://claude.ai/settings/usage",
  "loadTimeoutMs": 45000,
  "returns": {
    "type": "object",
    "fields": {
      "plan": "string",
      "limits": {
        "type": "array",
        "items": {
          "name": "string",
          "percent": "string",
          "resets_at": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "usage_credits": {
        "type": "object",
        "fields": {
          "enabled": "boolean",
          "spent_minor": "integer",
          "monthly_limit_minor": "integer",
          "balance_minor": "integer",
          "currency": "string",
          "percent": "string",
          "resets_at": "string",
          "auto_reload": "boolean"
        }
      }
    }
  },
  "effects": {
    "reads": [
      "claude.ai/settings/usage"
    ],
    "writes": [],
    "idempotent": true,
    "cache": 60
  },
  "resolve": [
    {
      "kind": "http",
      "credentials": true,
      "sources": {
        "orgs": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations"
          }
        },
        "usage": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/{sources.orgs.body.0.uuid}/usage"
          }
        },
        "credits": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/{sources.orgs.body.0.uuid}/overage_spend_limit"
          }
        },
        "balance": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/{sources.orgs.body.0.uuid}/prepaid/credits"
          }
        },
        "bundles": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/{sources.orgs.body.0.uuid}/prepaid/bundles"
          }
        }
      },
      "map": {
        "plan": "$sources.orgs.body[0].rate_limit_tier",
        "limits": "[$sources.usage.body.limits.{ 'name': kind = 'session' ? 'Current session' : kind = 'weekly_all' ? 'Weekly limit' : kind = 'weekly_scoped' ? ((scope.model.display_name ? scope.model.display_name & ' ' : '') & 'weekly limit') : kind, 'percent': $string(percent) & '%', 'resets_at': resets_at }]",
        "usage_credits": {
          "enabled": "$sources.credits.body.is_enabled = true",
          "spent_minor": "$sources.credits.body.used_credits",
          "monthly_limit_minor": "$sources.credits.body.monthly_credit_limit",
          "balance_minor": "$sources.balance.body.amount",
          "currency": "$sources.credits.body.currency",
          "percent": "$sources.credits.body.monthly_credit_limit > 0 ? $string($round($sources.credits.body.used_credits * 100 / $sources.credits.body.monthly_credit_limit)) & '%' : ''",
          "resets_at": "$sources.bundles.body.purchases_reset_at",
          "auto_reload": "$sources.balance.body.auto_reload_settings ? true : false"
        }
      },
      "exceptions": {
        "needs_auth": {
          "matches": "$sources.orgs.status = 401 or $sources.orgs.status = 403 or $sources.usage.status = 401 or $sources.usage.status = 403"
        }
      }
    },
    {
      "kind": "intercept",
      "sources": {
        "usage": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/*/usage*"
          }
        },
        "credits": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/*/overage_spend_limit*"
          }
        },
        "balance": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/*/prepaid/credits*"
          }
        },
        "bundles": {
          "request": {
            "method": "GET",
            "url": "https://claude.ai/api/organizations/*/prepaid/bundles*"
          }
        }
      },
      "reloadOnMiss": true,
      "waitMs": 8000,
      "map": {
        "limits": "[$sources.usage.body.limits.{ 'name': kind = 'session' ? 'Current session' : kind = 'weekly_all' ? 'Weekly limit' : kind = 'weekly_scoped' ? ((scope.model.display_name ? scope.model.display_name & ' ' : '') & 'weekly limit') : kind, 'percent': $string(percent) & '%', 'resets_at': resets_at }]",
        "usage_credits": {
          "enabled": "$sources.credits.body.is_enabled = true",
          "spent_minor": "$sources.credits.body.used_credits",
          "monthly_limit_minor": "$sources.credits.body.monthly_credit_limit",
          "balance_minor": "$sources.balance.body.amount",
          "currency": "$sources.credits.body.currency",
          "percent": "$sources.credits.body.monthly_credit_limit > 0 ? $string($round($sources.credits.body.used_credits * 100 / $sources.credits.body.monthly_credit_limit)) & '%' : ''",
          "resets_at": "$sources.bundles.body.purchases_reset_at",
          "auto_reload": "$sources.balance.body.auto_reload_settings ? true : false"
        }
      },
      "exceptions": {
        "needs_auth": {
          "matches": "$sources.usage.status = 401 or $sources.usage.status = 403 or $sources.credits.status = 401 or $sources.credits.status = 403"
        }
      }
    },
    {
      "kind": "dom",
      "fields": {
        "dialog": {
          "selector": "[role='dialog']"
        }
      },
      "post": "($value.dialog and $contains($value.dialog, 'Plan usage limits')) ? ($a := $substringAfter($value.dialog, 'Plan usage limits'); $contains($a, 'Current session') ? { 'plan': $trim($substringBefore($a, 'Current session')) } : {}) : {}",
      "exceptions": {
        "needs_auth": {
          "matches": "$contains($page.url, '/login') or $contains($page.url, '/logout') or $contains($page.title, 'Log in')"
        }
      }
    },
    {
      "kind": "llm",
      "prompt": "This is the Claude.ai usage settings page. Return a single object {plan, limits, usage_credits}. plan is the current subscription plan name shown under the 'Plan usage limits' heading. limits is an array of {name, percent, resets_at}. usage_credits is {enabled, spent_minor, monthly_limit_minor, balance_minor, currency, percent, resets_at, auto_reload}; monetary values are integer minor currency units, so 4000 GBP means £40.00. If the page is a login/sign-in page, return the JSON string \"needs_auth\"."
    }
  ],
  "exceptions": {
    "needs_auth": {
      "$lens": "@djgrant/claude/login",
      "hint": "Ask the user to sign in to claude.ai in the open tab, then retry this call."
    }
  }
}
