{
  "manifest_version": 3,
  "name": "Lens Host",
  "version": "0.1.0",
  "description": "Executes lens calls from your agent (via the lens-host MCP server) in your own browser session.",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": ["tabs", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
