{
  "lens": "hn/item",
  "version": 1,
  "description": "A Hacker News story page: the story plus its comment thread. Long threads paginate; next_page is the following page of comments (null on the last page).",
  "accepts": [
    "https://news.ycombinator.com/item?id={id}",
    "https://news.ycombinator.com/item?id={id}&p={p}"
  ],
  "returns": {
    "type": "object",
    "fields": {
      "story": {
        "type": "object",
        "fields": { "title": "string", "url": "string", "score": "string" }
      },
      "comments": {
        "type": "array",
        "items": { "author": "string", "age": "string", "text": "string" }
      },
      "next_page": { "$lens": "hn/item@v1" }
    }
  },
  "outcomes": {
    "not_found": null
  },
  "effects": {
    "reads": ["news.ycombinator.com"],
    "writes": [],
    "idempotent": true,
    "cache": 120
  },
  "resolve": [
    {
      "kind": "dom",
      "item": ".comtr",
      "fields": {
        "author": { "selector": ".hnuser" },
        "age": { "selector": ".age" },
        "text": { "selector": ".commtext" },
        "indent": { "selector": ".ind", "attr": "indent" }
      },
      "post": "{ \"story\": { \"id\": $id }, \"comments\": $[text != null] }"
    },
    {
      "kind": "dom",
      "fields": {
        "next_page": { "selector": "a.morelink", "attr": "href" }
      }
    },
    {
      "kind": "llm",
      "prompt": "Extract this Hacker News story page as {story: {title, url, score}, comments: [{author, age, text}], next_page}. next_page is the href of the bottom 'More' link (the next page of comments) if present, otherwise null. Include only top-level fields you can actually see."
    }
  ]
}
